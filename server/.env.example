# Servidor
PORT=4000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma). "*" permite todos.
CORS_ORIGIN=*

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgres://pos:pos@localhost:5432/nodepos

# Autenticación
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h

# Negocio
# Tasa de IVA incluida en los precios (0.16 = 16%)
TAX_RATE=0.16
# Zona horaria usada para agrupar ventas por día en los reportes
BUSINESS_TIMEZONE=America/Mexico_City
CURRENCY=MXN

# Usuario administrador que crea el seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
