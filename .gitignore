# ─────────────────────────────────────────────────────────────
# nodePOS — reglas para todo el repositorio (server/ y client/)
# client/ y server/ tienen además su propio .gitignore.
# ─────────────────────────────────────────────────────────────

# ─── Dependencias ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─── Secretos y variables de entorno ─────────────────────────
# NUNCA subir: contienen la contraseña de la BD y JWT_SECRET
.env
.env.*
!.env.example
*.pem
*.p12
*.key

# Llaves de firma de Android (la de debug sí se versiona)
*.keystore
!debug.keystore
*.jks

# ─── Builds y salidas ────────────────────────────────────────
dist/
build/
coverage/
*.tsbuildinfo
*.jsbundle
*.apk
*.aab
*.ipa

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── React Native / Android ──────────────────────────────────
.gradle/
.kotlin/
.cxx/
local.properties
*.iml
*.hprof
captures/
.externalNativeBuild/
.metro-health-check*

# ─── React Native / iOS ──────────────────────────────────────
**/Pods/
/client/vendor/bundle/
xcuserdata/
DerivedData/
*.xcuserstate
*.hmap
**/.xcode.env.local

# ─── Fastlane ────────────────────────────────────────────────
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ─── Editores e IDEs ─────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ─── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Varios ──────────────────────────────────────────────────
*.tmp
.cache/
